{
  "outcome": "standalone_svg_and_editable_tab",
  "svg_export": {
    "raw_outer_html_allowed": false,
    "required_root_attributes": ["xmlns", "width", "height", "viewBox"],
    "background": "white",
    "remove_export_excluded_nodes": true,
    "verify_saved_artifact": true
  },
  "editor_tab": {
    "preserve_as_deliverable": true,
    "close_after_export": false,
    "user_can_export_revisions": ["svg", "png", "ped", "json"],
    "edits_mutate_delivered_files": false
  },
  "loopback_server": {
    "bind_host": "127.0.0.1",
    "stop_after_page_loaded": true
  }
}
